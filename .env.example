# Copy to .env and adjust. docker compose reads this file automatically.

# ---- database -------------------------------------------------------------
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=jobhunter
POSTGRES_PORT=5432

# ---- api ------------------------------------------------------------------
API_PORT=8000
# How often the collector sweeps every source. 0 disables the scheduler, which
# is what you want if you would rather trigger sweeps by hand.
SWEEP_INTERVAL_MINUTES=60
# Run one sweep as soon as the API starts, so a fresh install is not empty.
SWEEP_ON_STARTUP=true
LOG_LEVEL=INFO

# Which profile to load. Keep the real one out of git.
PROFILE_PATH=/app/config/profile.yml
LETTER_PATH=/app/config/letter.md

# ---- web ------------------------------------------------------------------
WEB_PORT=3000
# The browser talks to the API through this URL. Inside docker compose the
# service name resolves; from a browser on your machine it is localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- optional: Adzuna salary data ----------------------------------------
# Free key from https://developer.adzuna.com/ -- leave blank to skip.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
