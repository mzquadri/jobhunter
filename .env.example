# Copy to .env and adjust. docker compose reads this file automatically.

# ---- database -------------------------------------------------------------
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=jobhunter
POSTGRES_PORT=5432

# ---- api ------------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO

# How often CareerOS scans, and whether it scans on startup, are SETTINGS, not
# environment variables -- change them in the Automation screen. They take
# effect without a restart, which an env var could never do.

# Where to read the first-boot seed from. Keep the real one out of git.
PROFILE_PATH=/app/config/profile.yml
LETTER_PATH=/app/config/letter.md

# ---- web ------------------------------------------------------------------
WEB_PORT=3000
# The browser talks to the API through this URL. Inside docker compose the
# service name resolves; from a browser on your machine it is localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- optional: Adzuna salary data ----------------------------------------
# Free key from https://developer.adzuna.com/ -- leave blank to skip.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
